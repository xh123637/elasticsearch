Project[[result{r}#0, step{r}#1, _timeseries{r}#2]]
\_Limit[10000[INTEGER],false,false]
  \_Filter[ISNOTNULL(result{r}#0)]
    \_Eval[[TODOUBLE(result{r}#3) AS result#0]]
      \_Filter[step{r}#1 >= 0[DATETIME] AND step{r}#1 <= 253402300799999[DATETIME]]
        \_TopNBy[[Order[result{r}#3,DESC,LAST]],3[INTEGER],[step{r}#1]]
          \_Aggregate[[step{r}#1, _timeseries{r}#2],[VALUES(LASTOVERTIME_$1{r}#4,true[BOOLEAN],PT0S[TIME_DURATION]) AS result#3, step{r}#1, _timeseries{r}#2]]
            \_TimeSeriesAggregate[[_tsid{m}#5, step{r}#1],[LASTOVERTIME(network.bytes_in{f}#6,@timestamp{f}#7,true[BOOLEAN],PT0S[TIME_DURATION]) AS LASTOVERTIME_$1#4, step{r}#1 AS step#1, DIMENSIONVALUES(_timeseries{f}#2,true[BOOLEAN],PT0S[TIME_DURATION]) AS _timeseries#2],BUCKET(@timestamp{f}#7,PT1H[TIME_DURATION]),@timestamp{f}#7,PROMQL_COMMAND]
              \_Eval[[BUCKET(@timestamp{f}#7,PT1H[TIME_DURATION]) AS step#1]]
                \_EsRelation[k8s][@timestamp{f}#7, client.ip{f}#8, cluster{f}#9, event{f}#10, event_city{f}#11, event_city_boundary{f}#12, event_location{f}#13, event_log{f}#14, event_shape{f}#15, events_received{f}#16, network.bytes_in{f}#6, network.cost{f}#17, network.eth0.currently_connected_clients{f}#18, network.eth0.firmware_version{f}#19, network.eth0.last_up{f}#20, network.eth0.rx{f}#21, network.eth0.tx{f}#22, network.eth0.up{f}#23, network.total_bytes_in{f}#24, network.total_bytes_out{f}#25, network.total_cost{f}#26, pod{f}#27, region{f}#28, _timeseries{f}#2, _tsid{m}#5]