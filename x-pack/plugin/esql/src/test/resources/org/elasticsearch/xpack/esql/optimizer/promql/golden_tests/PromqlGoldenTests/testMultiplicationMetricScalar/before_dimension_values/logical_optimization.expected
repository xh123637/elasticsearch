Project[[network_in_bits{r}#0, step{r}#1, _timeseries{r}#2]]
\_Limit[10000[INTEGER],false,false]
  \_Filter[ISNOTNULL(network_in_bits{r}#0)]
    \_Eval[[TODOUBLE(network_in_bits{r}#3) AS network_in_bits#0]]
      \_Filter[step{r}#1 >= 0[DATETIME] AND step{r}#1 <= 253402300799999[DATETIME]]
        \_Aggregate[[step{r}#1, _timeseries{r}#4],[VALUES($$network.total_b>$VALUES$0{r$}#5,true[BOOLEAN],PT0S[TIME_DURATION]) AS network_in_bits#3, step{r}#1 AS step#1, _timeseries{r}#4 AS _timeseries#2]]
          \_Eval[[TODOUBLE(LASTOVERTIME_$1{r}#6) * 8.0[DOUBLE] AS $$network.total_b>$VALUES$0#5]]
            \_TimeSeriesAggregate[[_tsid{m}#7, step{r}#1],[LASTOVERTIME(network.total_bytes_in{f}#8,@timestamp{f}#9,true[BOOLEAN],PT0S[TIME_DURATION]) AS LASTOVERTIME_$1#6, VALUES(_timeseries{f}#2,true[BOOLEAN],PT0S[TIME_DURATION]) AS _timeseries#4, step{r}#1],BUCKET(@timestamp{f}#9,PT1H[TIME_DURATION]),@timestamp{f}#9,PROMQL_COMMAND]
              \_Eval[[BUCKET(@timestamp{f}#9,PT1H[TIME_DURATION]) AS step#1]]
                \_EsRelation[k8s][@timestamp{f}#9, client.ip{f}#10, cluster{f}#11, event{f}#12, event_city{f}#13, event_city_boundary{f}#14, event_location{f}#15, event_log{f}#16, event_shape{f}#17, events_received{f}#18, network.bytes_in{f}#19, network.cost{f}#20, network.eth0.currently_connected_clients{f}#21, network.eth0.firmware_version{f}#22, network.eth0.last_up{f}#23, network.eth0.rx{f}#24, network.eth0.tx{f}#25, network.eth0.up{f}#26, network.total_bytes_in{f}#8, network.total_bytes_out{f}#27, network.total_cost{f}#28, pod{f}#29, region{f}#30, _timeseries{f}#2, _tsid{m}#7]